{
  "name": "blog",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "prebuild": "npm run cms:sync && npm run seo:publish",
    "build": "astro check && astro build && node scripts/assert-build.mjs",
    "cms:sync": "node scripts/cms-sync.mjs",
    "content:publish": "node scripts/production-config.mjs && npm run build",
    "dev": "astro dev",
    "preview": "astro preview",
    "seo:check": "node scripts/seo-pipeline.mjs",
    "seo:publish": "node scripts/seo-pipeline.mjs --write",
    "start": "astro dev",
    "test": "node --test test/blog-seo.test.mjs test/seo-quality.test.mjs test/cms-sync.test.mjs test/production-config.test.mjs",
    "test:build": "node scripts/assert-build.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/starlight": "^0.29.2",
    "@astrojs/starlight-tailwind": "^2.0.3",
    "@astrojs/tailwind": "^5.1.2",
    "astro": "^4.16.15",
    "sharp": "^0.32.5",
    "starlight-blog": "^0.15.0",
    "typescript": "^5.4.5"
  }
}
