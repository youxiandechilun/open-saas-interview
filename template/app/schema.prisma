datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  EDITOR
  CREATOR
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  email                     String?         @unique
  username                  String?         @unique
  isAdmin                   Boolean         @default(false)
  role                      UserRole        @default(CREATOR)
  isDisabled                Boolean         @default(false)

  paymentProcessorUserId    String?         @unique
  lemonSqueezyCustomerPortalUrl String?     // You can delete this if you're not using Lemon Squeezy as your payments processor.
  subscriptionStatus        String?         // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan          String?         // 'hobby', 'pro'
  datePaid                  DateTime?
  credits                   Int             @default(3)

  gptResponses              GptResponse[]
  contactFormMessages       ContactFormMessage[]
  tasks                     Task[]
  files                     File[]
  cmsPosts                  CmsPost[]
  aiAnimations              AiAnimation[]
  aiUsageLogs               AiUsageLog[]
  aiQuotaWindows            AiQuotaWindow[]
  updatedAiProviderConfigs  AiProviderConfig[] @relation("AiProviderConfigUpdatedBy")

  @@index([role, isDisabled])
}

model GptResponse {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
}

model Task {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  description               String
  time                      String          @default("1")
  isDone                    Boolean         @default(false)
}

model File {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  name                      String
  type                      String
  s3Key                     String
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  totalViews                       Int             @default(0)
  prevDayViewsChangePercent        String          @default("0")
  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)

  sources                          PageViewSource[]
}

model PageViewSource {
  @@id([date, name])
  name                     String
  date                     DateTime        @default(now())

  dailyStats               DailyStats?     @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId             Int?

  visitors                 Int
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}

enum CmsPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CmsAuthor {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  slug String  @unique
  bio  String?

  posts CmsPost[]

  @@index([name])
}

model CmsTag {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  slug String @unique

  posts CmsPost[]

  @@index([name])
}

model CmsPost {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  slug        String        @unique
  excerpt     String
  content     String
  status      CmsPostStatus @default(DRAFT)
  publishedAt DateTime?

  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById String
  author      CmsAuthor @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId    String
  animation   AiAnimation? @relation(fields: [animationId], references: [id], onDelete: SetNull)
  animationId String?
  tags        CmsTag[]

  @@index([status, publishedAt])
  @@index([authorId, status])
  @@index([createdById, updatedAt])
  @@index([animationId])
}

model CmsPublicationEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId         String
  eventType      String
  contentVersion String
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  lastError      String?
  processedAt    DateTime?

  @@index([postId, createdAt])
  @@index([status, availableAt, createdAt])
}

enum AiAnimationStatus {
  READY
  FAILED
}

enum VideoStatus {
  NOT_REQUESTED
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

model AiAnimation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  title           String
  description     String?
  originalPrompt  String
  optimizedPrompt String
  promptScore     Int
  promptFeedback  Json
  html            String
  durationSeconds Int               @default(5)
  status          AiAnimationStatus @default(READY)
  generationError String?

  videoStatus      VideoStatus @default(NOT_REQUESTED)
  videoFormat      String?
  videoStoragePath String?
  videoMimeType    String?
  videoError       String?
  videoAttempts    Int         @default(0)
  videoJobId       String?
  videoUsageLogId  String?
  videoUpdatedAt   DateTime?
  videoLeaseExpiresAt DateTime?

  cmsPosts  CmsPost[]
  usageLogs AiUsageLog[]

  @@index([userId, createdAt])
  @@index([userId, videoStatus])
}

model AiUsageLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  animation   AiAnimation? @relation(fields: [animationId], references: [id], onDelete: SetNull)
  animationId String?

  operation           String
  idempotencyKey      String
  status              String
  promptTokens        Int     @default(0)
  completionTokens    Int     @default(0)
  totalTokens         Int     @default(0)
  estimatedCostMicros Int     @default(0)
  latencyMs           Int?
  errorCode           String?
  responseJson        Json?
  reservedTokens      Int             @default(0)
  quotaWindowStart    DateTime?
  expiresAt           DateTime?

  @@unique([userId, operation, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, status, expiresAt])
}

model AiQuotaWindow {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  operation    String
  windowStart  DateTime
  requestCount Int      @default(0)
  inFlight     Int      @default(0)
  tokenCount   Int      @default(0)

  @@unique([userId, operation, windowStart])
  @@index([userId, windowStart])
}

model AiProviderConfig {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baseUrl         String
  model           String
  encryptedApiKey String
  apiKeyHint      String
  hourlyTokenLimit      Int     @default(100000)
  maxCompletionTokens   Int     @default(12000)

  updatedBy   User   @relation("AiProviderConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  updatedById String

  @@index([updatedById])
}
