    "@wasp.sh/spec": "file:.wasp/spec",
    "dotenv": "^16.6.1",
    "pg": "^8.22.0",
    "prisma": "5.19.1",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
