    "lucide-react": "^0.525.0",
    "openai": "^6.27.0",
    "playwright": "1.61.1",
    "prettier": "3.1.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.1",
    "react-apexcharts": "2.1.0",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.60.0",
    "react-router": "^8.0.1",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^4.1.18",
