# MotionPress server configuration
# Copy only the values needed for the integrations you actually enable.

# -----------------------------------------------------------------------------
# Core local runtime
# -----------------------------------------------------------------------------

# Wasp can manage local PostgreSQL with `wasp start db`. Set DATABASE_URL only
# when using an existing PostgreSQL instance.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motionpress

# Comma-separated emails that receive ADMIN on verified signup.
ADMIN_EMAILS=admin@example.com

# Local development only. Keep false or unset in production.
SKIP_EMAIL_VERIFICATION_IN_DEV=true

# Stable 32-byte base64 key used to encrypt provider credentials saved in the UI.
# Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# AI_CONFIG_ENCRYPTION_KEY=

# Local development defaults to ~/.motionpress/ai-studio-videos when unset.
# Production must mount and configure an absolute persistent-volume path.
# AI_VIDEO_STORAGE_DIR=/var/lib/motionpress/ai-studio-videos

# -----------------------------------------------------------------------------
# Optional AI environment fallback
# -----------------------------------------------------------------------------

# The app starts without these values. An ADMIN can configure an OpenAI-compatible
# provider from Integrations after startup.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_STUDIO_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Optional content publishing integration
# -----------------------------------------------------------------------------

# Protect the public CMS feed when app and blog are deployed separately.
# CMS_CONTENT_API_TOKEN=

# Deployment/build hook called after a publication event.
# CMS_REBUILD_WEBHOOK_URL=
# CMS_REBUILD_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# Account email delivery
# -----------------------------------------------------------------------------

# Local development logs verification/reset links to the server console.
EMAIL_PROVIDER=Dummy
EMAIL_FROM_NAME=MotionPress
EMAIL_FROM_ADDRESS=noreply@motionpress.local

# Production builds require SendGrid and a verified sender address.
# EMAIL_PROVIDER=SendGrid
# SENDGRID_API_KEY=
# EMAIL_FROM_ADDRESS=hello@your-domain.example

# -----------------------------------------------------------------------------
# Optional authentication and analytics integrations
# -----------------------------------------------------------------------------

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# PLAUSIBLE_API_KEY=
# PLAUSIBLE_SITE_ID=
# PLAUSIBLE_BASE_URL=https://plausible.io/api
# GOOGLE_ANALYTICS_CLIENT_EMAIL=
# GOOGLE_ANALYTICS_PRIVATE_KEY=
# GOOGLE_ANALYTICS_PROPERTY_ID=
